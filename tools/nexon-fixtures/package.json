{
  "name": "@lara/nexon-fixtures",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "nexon-fixtures": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "record": "node --import tsx src/cli.ts record",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "node --import tsx src/cli.ts verify"
  },
  "dependencies": {
    "@lara/nexon-client": "workspace:*"
  },
  "devDependencies": {
    "@lara/character-pipeline": "workspace:*",
    "@lara/data-store": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "tags": [
      "scope:nexon",
      "type:tool"
    ]
  }
}
